# Copy this file to .env and fill it in. Never commit .env.

# Google AI Studio key from the hackathon credits
GEMINI_API_KEY=
# Exact model id from the DeepMind track brief (Gemini 4 Argon)
GEMINI_MODEL=

# MongoDB Atlas (Bogdan shares this privately)
MONGODB_URI=
MONGODB_DB=govcheck

# Voyage AI key for embedding the regulations (MongoDB booth / Atlas)
VOYAGE_API_KEY=

# 1 = POST /scan returns docs/example_scan.json (for frontend work). Set to 0 for real scans.
MOCK_SCAN=1
