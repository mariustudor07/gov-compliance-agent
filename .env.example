# Copy this file to .env and fill it in. Never commit .env.

# Google AI Studio key from the hackathon credits
GEMINI_API_KEY=
# Exact model id from the DeepMind track brief (Gemini 4 Argon)
GEMINI_MODEL=

# MongoDB Atlas (Bogdan shares this privately)
MONGODB_URI=
MONGODB_DB=Audit_AI_Db

# Voyage AI key for embedding the regulations (MongoDB booth / Atlas)
VOYAGE_API_KEY=

# 1 = POST /scan returns docs/example_scan.json (for frontend work). Set to 0 for real scans.
MOCK_SCAN=1

# --- MongoDB users (Bogdan's design: two users) -----------------------------------------
# Cluster address, without mongodb+srv:// and without user/password:
MONGODB_HOST=legalsources.o0aaii4.mongodb.net
# App user: restricted role (govcheck_agent). Used by the app and the AI agent.
MONGODB_APP_USER=
MONGODB_APP_PASSWORD=
# Admin user: full access. ONLY for scripts run by hand (python -m db.seed, python -m db.embed_rules).
MONGODB_ADMIN_USER=
MONGODB_ADMIN_PASSWORD=
# While the app user fields are empty, MONGODB_URI above is used for everything.
